class UltraAccuracyOCREngine:
    """موتور OCR با دقت فوق العاده"""

    def __init__(self, ai_models, progress_callback=None):
        self.ai_models = ai_models
        self.progress_callback = progress_callback
        self.setup_advanced_ocr()

    def setup_advanced_ocr(self):
        """تنظیمات پیشرفته OCR"""
        # تنظیمات Tesseract برای دقت بالا
        self.tesseract_configs = [
            r'--oem 3 --psm 6 -c tessedit_char_whitelist=آابپتثجچحخدذرزژسشصضطظعغفقکگلمنوهیءةيك۰۱۲۳۴۵۶۷۸۹٠١٢٣٤٥٦٧٨٩ :.,-()',
            r'--oem 3 --psm 4 -c preserve_interword_spaces=1',
            r'--oem 3 --psm 8'
        ]

    def update_progress(self, value, message):
        """به‌روزرسانی پیشرفت"""
        if self.progress_callback:
            self.progress_callback(value, message)

    def extract_text_ultra_accurate(self, input_file) -> Tuple[str, Dict[str, Any]]:
        """استخراج متن با دقت فوق العاده"""
        self.update_progress(10, "🔍 شروع استخراج متن...")

        results = {
            'methods': {},
            'confidence_scores': {},
            'processing_times': {},
            'quality_metrics': {}
        }

        try:
            self.update_progress(20, "📖 پردازش موازی OCR...")

            # پردازش موازی OCR
            with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
                tesseract_future = executor.submit(self._advanced_tesseract_extraction, input_file)
                easyocr_future = executor.submit(self._safe_easyocr_extraction, input_file)
                
                tesseract_results = tesseract_future.result()
                easyocr_results = easyocr_future.result()

            results['methods']['tesseract_advanced'] = tesseract_results
            results['methods']['easyocr_precision'] = easyocr_results

            self.update_progress(60, "🤖 ترکیب هوشمند نتایج...")

            # ترکیب هوشمند نتایج
            if easyocr_results['text']:
                combined_text, fusion_metrics = self._intelligent_fusion(
                    tesseract_results['text'],
                    easyocr_results['text']
                )
            else:
                combined_text = tesseract_results['text']
                fusion_metrics = {'method': 'tesseract_only'}

            results['combined_text'] = combined_text
            results['fusion_metrics'] = fusion_metrics
            results['quality_metrics'] = self._calculate_comprehensive_quality(combined_text)

            self.update_progress(80, "✅ استخراج متن کامل شد")
            print(f"✅ استخراج کامل - طول متن: {len(combined_text)} کاراکتر")
            return combined_text, results

        except Exception as e:
            print(f"❌ خطا در استخراج متن: {e}")
            # بازگشت به روش ساده در صورت خطا
            try:
                simple_text = self._simple_extraction(input_file)
                return simple_text, results
            except:
                return "", results

    def _advanced_tesseract_extraction(self, input_file) -> Dict[str, Any]:
        """استخراج پیشرفته با Tesseract"""
        start_time = datetime.now()

        try:
            if isinstance(input_file, str) and input_file.lower().endswith('.pdf'):
                # پردازش 6 صفحه اول (کاهش از 8 صفحه)
                images = convert_from_path(input_file, first_page=1, last_page=6, dpi=300)
                all_texts = []

                for i, image in enumerate(images):
                    self.update_progress(25 + i*5, f"📄 پردازش صفحه {i+1} با Tesseract...")

                    # پیش‌پردازش تصویر
                    processed_image = self._preprocess_image(image)

                    # اجرای چندین تنظیمات مختلف
                    page_texts = []
                    for config in self.tesseract_configs:
                        try:
                            text = pytesseract.image_to_string(
                                processed_image,
                                lang='fas+eng',
                                config=config
                            )
                            if text.strip():
                                page_texts.append(text)
                        except Exception as e:
                            continue

                    # انتخاب بهترین متن برای هر صفحه
                    if page_texts:
                        best_page_text = max(page_texts, key=lambda x: len(x))
                        all_texts.append(f"--- صفحه {i+1} ---\n{best_page_text}")

                final_text = '\n'.join(all_texts)

            else:
                # پردازش فایل تصویری
                if isinstance(input_file, str):
                    image = Image.open(input_file)
                else:
                    image = input_file

                processed_image = self._preprocess_image(image)
                final_text = pytesseract.image_to_string(processed_image, lang='fas+eng')

            processing_time = (datetime.now() - start_time).total_seconds()

            return {
                'text': final_text,
                'confidence': 0.8,
                'processing_time': processing_time,
                'method': 'tesseract_advanced'
            }

        except Exception as e:
            print(f"⚠️ خطا در Tesseract: {e}")
            return {'text': '', 'confidence': 0, 'processing_time': 0, 'method': 'error'}

    def _safe_easyocr_extraction(self, input_file) -> Dict[str, Any]:
        """استخراج ایمن با EasyOCR"""
        start_time = datetime.now()

        if not self.ai_models.easy_ocr_reader:
            return {'text': '', 'confidence': 0, 'processing_time': 0, 'method': 'not_available'}

        try:
            if isinstance(input_file, str) and input_file.lower().endswith('.pdf'):
                # پردازش 6 صفحه اول (کاهش از 8 صفحه)
                images = convert_from_path(input_file, first_page=1, last_page=6, dpi=300)
                all_texts = []
                confidences = []

                for i, image in enumerate(images):
                    self.update_progress(30 + i*5, f"📄 پردازش صفحه {i+1} با EasyOCR...")

                    image_np = np.array(image)

                    # تشخیص با پارامترهای دقیق
                    results = self.ai_models.easy_ocr_reader.readtext(
                        image_np,
                        paragraph=True,
                        min_size=10,
                        text_threshold=0.4,
                        low_text=0.3
                    )

                    page_text = ""
                    for result in results:
                        if len(result) >= 3:
                            text = result[1]
                            confidence = result[2]
                        elif len(result) == 2:
                            text = result[1]
                            confidence = 0.7
                        else:
                            continue

                        if confidence > 0.4:
                            page_text += text + " "
                            confidences.append(confidence)

                    if page_text.strip():
                        all_texts.append(f"--- صفحه {i+1} ---\n{page_text.strip()}")

                final_text = '\n'.join(all_texts)
                avg_confidence = np.mean(confidences) if confidences else 0

            else:
                if isinstance(input_file, str):
                    image = Image.open(input_file)
                    image_np = np.array(image)
                else:
                    image_np = np.array(input_file)

                results = self.ai_models.easy_ocr_reader.readtext(
                    image_np,
                    paragraph=True,
                    text_threshold=0.5
                )

                extracted_texts = []
                confidences = []
                for result in results:
                    if len(result) >= 3:
                        text = result[1]
                        confidence = result[2]
                    elif len(result) == 2:
                        text = result[1]
                        confidence = 0.7
                    else:
                        continue

                    if confidence > 0.4:
                        extracted_texts.append(text)
                        confidences.append(confidence)

                final_text = " ".join(extracted_texts)
                avg_confidence = np.mean(confidences) if confidences else 0

            processing_time = (datetime.now() - start_time).total_seconds()

            return {
                'text': final_text,
                'confidence': avg_confidence,
                'processing_time': processing_time,
                'method': 'easyocr_safe'
            }

        except Exception as e:
            print(f"⚠️ خطا در EasyOCR: {e}")
            return {'text': '', 'confidence': 0, 'processing_time': 0, 'method': 'error'}

    def _simple_extraction(self, input_file) -> str:
        """استخراج ساده برای مواقع اضطراری"""
        try:
            if isinstance(input_file, str) and input_file.lower().endswith('.pdf'):
                # پردازش 6 صفحه اول (کاهش از 8 صفحه)
                images = convert_from_path(input_file, first_page=1, last_page=6, dpi=200)
                texts = []
                for image in images:
                    text = pytesseract.image_to_string(image, lang='fas')
                    if text.strip():
                        texts.append(text)
                return '\n'.join(texts)
            else:
                if isinstance(input_file, str):
                    image = Image.open(input_file)
                else:
                    image = input_file
                return pytesseract.image_to_string(image, lang='fas')
        except:
            return ""

    def _preprocess_image(self, image):
        """پیش‌پردازش ساده تصویر"""
        try:
            if image.mode != 'L':
                image = image.convert('L')
            enhancer = ImageEnhance.Contrast(image)
            image = enhancer.enhance(1.3)
            return image
        except:
            return image

    def _intelligent_fusion(self, text1: str, text2: str) -> Tuple[str, Dict[str, float]]:
        """ترکیب هوشمند متون"""
        if not text1 and not text2:
            return "", {'method': 'empty'}

        if not text1:
            return text2, {'method': 'easyocr_only'}

        if not text2:
            return text1, {'method': 'tesseract_only'}

        lines1 = text1.split('\n')
        lines2 = text2.split('\n')
        fused_lines = []

        max_lines = max(len(lines1), len(lines2))
        for i in range(max_lines):
            line1 = lines1[i] if i < len(lines1) else ""
            line2 = lines2[i] if i < len(lines2) else ""

            line1_clean = line1.strip()
            line2_clean = line2.strip()

            if not line1_clean and not line2_clean:
                continue

            if self._calculate_line_quality(line1_clean) >= self._calculate_line_quality(line2_clean):
                fused_lines.append(line1_clean)
            else:
                fused_lines.append(line2_clean)

        fused_text = '\n'.join(fused_lines)

        return fused_text, {
            'method': 'fusion',
            'lines_combined': len(fused_lines),
            'quality_score': self._calculate_text_quality(fused_text)
        }

    def _calculate_line_quality(self, line: str) -> float:
        """محاسبه کیفیت خط"""
        if not line.strip():
            return 0.0

        score = 0.0
        if 5 <= len(line) <= 200:
            score += 0.3

        persian_chars = len(re.findall(r'[آ-ی]', line))
        if persian_chars >= 2:
            score += 0.4

        words = line.split()
        if 1 <= len(words) <= 20:
            score += 0.3

        return min(score, 1.0)

    def _calculate_text_quality(self, text: str) -> float:
        """محاسبه کیفیت کلی متن"""
        lines = [line.strip() for line in text.split('\n') if line.strip()]
        if not lines:
            return 0.0

        line_qualities = [self._calculate_line_quality(line) for line in lines]
        return np.mean(line_qualities) if line_qualities else 0.0

    def _calculate_comprehensive_quality(self, text: str) -> Dict[str, float]:
        """محاسبه کیفیت جامع متن"""
        quality_score = self._calculate_text_quality(text)
        lines = [line.strip() for line in text.split('\n') if line.strip()]
        persian_chars = len(re.findall(r'[آ-ی]', text))
        total_chars = len(text)

        return {
            'overall_score': quality_score,
            'line_count': len(lines),
            'persian_ratio': persian_chars / total_chars if total_chars > 0 else 0,
            'total_chars': total_chars
        }

