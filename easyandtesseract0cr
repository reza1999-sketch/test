class APIEnhancedMetadataExtractor:
    """استخراج کننده متادیتا با قدرت API"""
    
    def __init__(self, rag_system, progress_callback=None):
        self.rag_system = rag_system
        self.progress_callback = progress_callback
        self.setup_extraction_prompts()
    
    def update_progress(self, value, message):
        """به‌روزرسانی پیشرفت"""
        if self.progress_callback:
            self.progress_callback(value, message)
    
    def setup_extraction_prompts(self):
        """تنظیم پرامپت‌های تخصصی استخراج با تمرکز بر بخش‌های حیاتی"""
        self.extraction_prompts = {
            'comprehensive': """
            شما یک متخصص استخراج اطلاعات کتاب الکترونیکی هستید. لطفاً با دقت فوق‌العاده اطلاعات حیاتی زیر را از متن کتاب استخراج کنید:

            متن کتاب:
            {text}
            
            بخش‌های حیاتی برای استخراج:

            1. عنوان کتاب (ضروری)
               - عنوان اصلی (ضروری)
               - عنوان فرعی (در صورت وجود)

            2. نام نویسنده/نویسندگان (ضروری)
               - نام کامل نویسنده اصلی
               - نویسندگان همکار (در صورت وجود)

            3. مترجم (ضروری برای کتاب‌های ترجمه)

            4. ناشر و سال انتشار (ضروری)
               - نام رسمی ناشر
               - سال انتشار به عدد فارسی (مثلاً: ۱۳۹۷، ۱۴۰۰)

            5. شابک (ISBN یا eISBN) (بسیار مهم)

            6. نوبت چاپ

            قوانین استخراج دقیق:
            - برای سال انتشار، به دنبال الگوهای زیر باشید:
              * "سال انتشار: ۱۳۹۷"
              * "چاپ: ۱۳۹۸" 
              * "زمستان ۱۳۹۷"
              * "۱۳۹۷"
            - اگر سال به صورت فصلی ذکر شده، فقط عدد سال را استخراج کنید
            - اعداد را به صورت فارسی برگردانید
            - مطمئن شوید سال انتشار ۴ رقمی است
            - برای نویسنده و ناشر، کلمات را با فاصله صحیح بنویسید

            فرمت خروجی JSON:
            {{
                "title": "عنوان اصلی کتاب",
                "author": "نام نویسنده اصلی",
                "translator": "نام مترجم",
                "publisher": "نام ناشر",
                "publication_year": "سال انتشار",
                "isbn": "شابک کتاب",
                "edition": "نوبت چاپ"
            }}

            پاسخ را فقط به صورت JSON برگردانید:
            """
        }
    
    def extract_with_api_power(self, text: str) -> Dict[str, Any]:
        """استخراج متادیتا با قدرت API"""
        self.update_progress(70, "🧠 استخراج اطلاعات با قدرت API...")
        
        if not self.rag_system.llm:
            print("❌ API در دسترس نیست - استفاده از روش‌های معمولی")
            return self._extract_without_api(text)
        
        max_retries = len(self.rag_system.api_keys)
        
        for retry in range(max_retries):
            try:
                # مرحله 1: استخراج جامع با API
                chunk = text[:3000]
                prompt = self.extraction_prompts['comprehensive'].format(text=chunk)
                
                initial_metadata = self._call_api_for_extraction(prompt)
                
                if initial_metadata and any(initial_metadata.values()):
                    # پس‌پردازش و تصحیح
                    final_metadata = self._post_process_metadata(initial_metadata, text)
                    
                    self.update_progress(85, "✅ استخراج با API تکمیل شد")
                    print("✅ استخراج با API تکمیل شد")
                    return final_metadata
                else:
                    print(f"⚠️ API شماره {retry + 1} نتیجه‌ای برنگرداند")
                    if retry < max_retries - 1:
                        self.rag_system.switch_to_next_api()
                    
            except Exception as e:
                print(f"❌ خطا در استخراج با API شماره {retry + 1}: {e}")
                if retry < max_retries - 1:
                    self.rag_system.switch_to_next_api()
                continue
        
        print("❌ همه APIها شکست خوردند - استفاده از روش‌های معمولی")
        return self._extract_without_api(text)
    
    def _extract_without_api(self, text: str) -> Dict[str, Any]:
        """استخراج بدون API - استفاده از روش‌های محلی"""
        self.update_progress(70, "🔍 استخراج اطلاعات با روش‌های محلی...")
        
        metadata = {}
        
        # استخراج عنوان از خطوط اول
        title = self._extract_title_from_first_lines(text)
        if title:
            metadata['title'] = title
            print(f"✅ عنوان استخراج شد: {title}")
        
        # استخراج سایر اطلاعات با الگوهای منظم
        metadata.update(self._extract_with_patterns(text))
        
        return metadata
    
    def _extract_title_from_first_lines(self, text: str) -> str:
        """استخراج عنوان از خطوط اول متن"""
        lines = [line.strip() for line in text.split('\n') if line.strip()]
        
        # بررسی 10 خط اول
        for i, line in enumerate(lines[:10]):
            if (10 <= len(line) <= 150 and
                len(re.findall(r'[آ-ی]', line)) >= 2 and
                not any(word in line for word in ['نویسنده', 'مؤلف', 'ناشر', 'چاپ', 'شابک', 'مترجم', 'فهرست', 'مقدمه'])):
                return line
        
        return ""
    
    def _extract_with_patterns(self, text: str) -> Dict[str, Any]:
        """استخراج اطلاعات با الگوهای منظم"""
        patterns = {
            'author': [
                r'نویسنده\s*[:\-]\s*([^\n]+)',
                r'مؤلف\s*[:\-]\s*([^\n]+)',
                r'تألیف\s*[:\-]\s*([^\n]+)'
            ],
            'publisher': [
                r'ناشر\s*[:\-]\s*([^\n]+)',
                r'انتشارات\s*[:\-]\s*([^\n]+)'
            ],
            'publication_year': [
                r'سال\s*انتشار\s*[:\-]\s*([۱۳۴۰-۹]{4})',
                r'چاپ\s*[:\-]\s*.*?([۱۳۴۰-۹]{4})',
                r'تاریخ\s*انتشار\s*[:\-]\s*([۱۳۴۰-۹]{4})'
            ],
            'isbn': [
                r'شابک\s*[:\-]\s*([۰-۹\-–]+)',
                r'ISBN\s*[:\-]\s*([۰-۹\-–]+)'
            ],
            'edition': [
                r'چاپ\s*(\d+)',
                r'نوبت چاپ\s*[:\-]\s*(\d+)',
                r'چاپ\s*(اول|دوم|سوم|چهارم|پنجم|ششم|هفتم|هشتم|نهم|دهم)'
            ],
            'translator': [
                r'مترجم\s*[:\-]\s*([^\n]+)',
                r'ترجمه\s*[:\-]\s*([^\n]+)',
                r'برگردان\s*[:\-]\s*([^\n]+)'
            ]
        }
        
        results = {}
        for field, pattern_list in patterns.items():
            for pattern in pattern_list:
                match = re.search(pattern, text, re.IGNORECASE)
                if match:
                    results[field] = match.group(1).strip()
                    break
        
        return results
    
    def _call_api_for_extraction(self, prompt: str) -> Dict[str, Any]:
        """فراخوانی API برای استخراج"""
        try:
            from llama_index.core import Document
            doc = Document(text=prompt)
            
            query_engine = self.rag_system.knowledge_base.as_query_engine(
                llm=self.rag_system.llm,
                similarity_top_k=3,
                response_mode="compact"
            )
            
            response = query_engine.query(prompt)
            response_text = str(response).strip()
            
            return self._extract_json_from_response(response_text)
            
        except Exception as e:
            print(f"⚠️ خطا در فراخوانی API: {e}")
            return {}
    
    def _extract_json_from_response(self, response: str) -> Dict[str, Any]:
        """استخراج JSON از پاسخ API"""
        try:
            json_patterns = [
                r'\{[^{}]*\}',
                r'```json\s*(\{.*?\})\s*```',
                r'```\s*(\{.*?\})\s*```'
            ]
            
            for pattern in json_patterns:
                matches = re.findall(pattern, response, re.DOTALL)
                for match in matches:
                    try:
                        if isinstance(match, tuple):
                            match = match[0]
                        return json.loads(match)
                    except:
                        continue
            
            lines = response.split('\n')
            json_like = {}
            
            for line in lines:
                line = line.strip()
                if ':' in line and not line.startswith('{') and not line.startswith('}'):
                    parts = line.split(':', 1)
                    if len(parts) == 2:
                        key, value = parts
                        key = key.strip().strip('"\'')
                        value = value.strip().strip('",\'')
                        if key and value:
                            json_like[key] = value
            
            return json_like if json_like else {}
            
        except Exception as e:
            print(f"⚠️ خطا در استخراج JSON: {e}")
            return {}

    def _post_process_metadata(self, metadata: Dict[str, Any], text: str) -> Dict[str, Any]:
        """پس‌پردازش و تصحیح متادیتا"""
        processed = metadata.copy()
        
        # اگر عنوان پیدا نشده، از روش جایگزین استفاده کن
        if not processed.get('title'):
            title = self._extract_title_from_first_lines(text)
            if title:
                processed['title'] = title
                print(f"✅ عنوان اضافه شد: {title}")
        
        return processed

