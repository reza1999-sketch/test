            <pre style="background: #000000; color: #ff0000; padding: 10px; border-radius: 5px; border: 1px solid #ff0000;">{error_message}</pre>
        </div>
        """
    
    def _save_results(self, results, file_path):
        """ذخیره نتایج در فایل"""
        try:
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            base_name = os.path.splitext(os.path.basename(file_path))[0]
            
            # ذخیره JSON
            json_filename = f"{base_name}_نتایج_{timestamp}.json"
            with open(json_filename, 'w', encoding='utf-8') as f:
                json.dump(results, f, ensure_ascii=False, indent=2)
            
            # ذخیره گزارش متنی
            txt_filename = f"{base_name}_گزارش_{timestamp}.txt"
            report_content = self._create_text_report(results)
            with open(txt_filename, 'w', encoding='utf-8') as f:
                f.write(report_content)
            
            return json_filename, txt_filename
            
        except Exception as e:
            print(f"خطا در ذخیره فایل‌ها: {e}")
            return None, None
    
    def _create_text_report(self, results):
        """ایجاد گزارش متنی"""
        basic_info = results.get('basic_info', {})
        
        report = f"""📊 گزارش کامل تحلیل کتاب
{'='*50}

📚 اطلاعات شناسنامه کتاب:
{'-'*30}
"""
        
        fields = [
            ('title', 'عنوان کتاب'),
            ('author', 'نویسنده/مؤلف'),
            ('translator', 'مترجم'),
            ('publisher', 'ناشر'),
            ('publication_year', 'سال انتشار'),
            ('isbn', 'شابک (ISBN)'),
            ('edition', 'نوبت چاپ')
        ]
        
        for field, title in fields:
            value = basic_info.get(field, "یافت نشد")
            report += f"- {title}: {value}\n"
        
        report += f"""
🔧 اطلاعات فنی پردازش:
{'-'*30}
- زمان پردازش: {results.get('processing_time', 0):.2f} ثانیه
- طول متن استخراج شده: {results.get('total_text_length', 0)} کاراکتر
- سیستم API: {'فعال' if results.get('api_enhanced') else 'غیرفعال'}
- سیستم RAG: {'فعال' if results.get('rag_available') else 'غیرفعال'}

🕒 تاریخ پردازش: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
"""
        
        return report
    
