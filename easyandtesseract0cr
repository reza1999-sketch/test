class SimpleBookExtractor:
    """استخراج ساده اطلاعات کتاب"""

    def extract_basic_info(self, text: str) -> Dict[str, Any]:
        """استخراج اطلاعات پایه"""
        results = {}
        lines = text.split('\n')

        # استخراج عنوان از خطوط اول
        title = self._extract_title_from_first_lines(lines)
        if title:
            results['title'] = title

        for i, line in enumerate(lines):
            line = line.strip()
            if not line:
                continue

            year = self._extract_year(line)
            if year and 'year' not in results:
                results['year'] = year

            edition = self._extract_edition(line)
            if edition and 'edition' not in results:
                results['edition'] = edition

            author = self._extract_author(line)
            if author and 'author' not in results:
                results['author'] = author

            translator = self._extract_translator(line)
            if translator and 'translator' not in results:
                results['translator'] = translator

        return results

    def _extract_title_from_first_lines(self, all_lines: List[str]) -> str:
        """استخراج عنوان از خطوط اول"""
        # بررسی 10 خط اول
        first_lines = [line.strip() for line in all_lines[:10] if line.strip()]
        
        for line in first_lines:
            if (10 <= len(line) <= 150 and
                len(re.findall(r'[آ-ی]', line)) >= 2 and
                not any(word in line for word in ['نویسنده', 'مؤلف', 'ناشر', 'چاپ', 'شابک', 'مترجم', 'فهرست'])):
                return line
        
        return ""

    def _extract_year(self, line: str) -> str:
        """استخراج سال"""
        year_patterns = [
            r'۱۳[۷-۹][۰-۹]',
            r'۱۴۰[۰-۴]',
            r'سال\s*انتشار\s*[:\-]\s*([۱۳۴۰-۹]{4})',
            r'چاپ\s*[:\-]\s*.*?([۱۳۴۰-۹]{4})'
        ]
        for pattern in year_patterns:
            match = re.search(pattern, line)
            if match:
                year = match.group(1) if match.groups() else match.group()
                if self._is_valid_year(year):
                    return year
        return ""

    def _extract_edition(self, line: str) -> str:
        """استخراج نوبت چاپ"""
        edition_patterns = [
            r'چاپ\s*(\d+)',
            r'نوبت چاپ\s*[:\-]\s*(\d+)',
            r'چاپ\s*(اول|دوم|سوم|چهارم|پنجم|ششم|هفتم|هشتم|نهم|دهم)',
        ]
        for pattern in edition_patterns:
            match = re.search(pattern, line, re.IGNORECASE)
            if match:
                return match.group(1) if match.groups() else match.group(0)
        return ""

    def _extract_author(self, line: str) -> str:
        """استخراج نویسنده"""
        author_patterns = [
            r'نویسنده\s*[:\-]\s*(.+)',
            r'مؤلف\s*[:\-]\s*(.+)',
            r'تألیف\s*[:\-]\s*(.+)',
        ]
        for pattern in author_patterns:
            match = re.search(pattern, line, re.IGNORECASE)
            if match:
                author = match.group(1).strip()
                if self._is_valid_author(author):
                    return author
        return ""

    def _extract_translator(self, line: str) -> str:
        """استخراج مترجم"""
        translator_patterns = [
            r'مترجم\s*[:\-]\s*(.+)',
            r'ترجمه\s*[:\-]\s*(.+)',
            r'برگردان\s*[:\-]\s*(.+)',
        ]
        for pattern in translator_patterns:
            match = re.search(pattern, line, re.IGNORECASE)
            if match:
                translator = match.group(1).strip()
                if self._is_valid_translator(translator):
                    return translator
        return ""

    def _is_valid_author(self, text: str) -> bool:
        """اعتبارسنجی نویسنده"""
        return (3 <= len(text) <= 80 and
                len(re.findall(r'[آ-ی]', text)) >= 1)

    def _is_valid_translator(self, text: str) -> bool:
        """اعتبارسنجی مترجم"""
        return (3 <= len(text) <= 80 and
                len(re.findall(r'[آ-ی]', text)) >= 1)

    def _is_valid_year(self, year: str) -> bool:
        """اعتبارسنجی سال"""
        if not year or len(year) != 4:
            return False
        return year.startswith(('۱۳', '۱۴'))

    def extract_additional_info(self, text: str) -> Dict[str, Any]:
        """استخراج اطلاعات تکمیلی"""
        results = {}

        patterns = {
            'publisher': r'ناشر\s*[:\-]\s*(.+)',
            'isbn': r'شابک\s*[:\-]\s*([۰-۹\-–]+)',
            'price': r'قیمت\s*[:\-]\s*([۰-۹,]+)\s*تومان',
            'translator': r'مترجم\s*[:\-]\s*(.+)',
            'subject': r'موضوع\s*[:\-]\s*(.+)'
        }

        for field, pattern in patterns.items():
            match = re.search(pattern, text, re.IGNORECASE)
            if match:
                results[field] = match.group(1).strip()

        return results

