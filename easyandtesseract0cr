class AdvancedRAGSystem:
    """سیستم RAG پیشرفته برای استخراج و تحلیل متادیتا"""

    def __init__(self):
        # API Keyهای مختلف
        self.api_keys = [
            "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",  # API اصلی شما
            "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",  # API عمومی 1
            "sk-or-v1-9e5b5c5e5f5a5b5c5d5e5f5a5b5c5d5e5f5a5b5c5d5e5f5a5b5c5d5e5f5a5b5c"   # API عمومی 2
        ]
        self.current_api_index = 0
        self.setup_llm()
        self.knowledge_base = None

    def setup_llm(self):
        """تنظیم مدل زبانی با API Keyهای مختلف"""
        for i in range(len(self.api_keys)):
            try:
                from llama_index.llms.openrouter import OpenRouter
                from llama_index.embeddings.huggingface import HuggingFaceEmbedding

                self.llm = OpenRouter(
                    model="meta-llama/llama-3-70b-instruct",
                    temperature=0.1,
                    max_tokens=2000,
                    context_window=8000,
                    api_key=self.api_keys[i]
                )

                self.embed_model = HuggingFaceEmbedding(
                    model_name="sentence-transformers/paraphrase-multilingual-mpnet-base-v2"
                )

                self.current_api_index = i
                source = "شما" if i == 0 else f"عمومی {i}"
                print(f"✅ مدل زبانی RAG با API Key {source} تنظیم شد")
                return

            except Exception as e:
                print(f"❌ خطا در تنظیم مدل RAG با API Key {i+1}: {e}")
                continue

        # اگر همه APIها شکست خوردند
        print("❌ همه APIها شکست خوردند - استفاده از روش‌های معمولی")
        self.llm = None
        self.embed_model = None

    def switch_to_next_api(self):
        """تعویض به API بعدی"""
        self.current_api_index = (self.current_api_index + 1) % len(self.api_keys)
        print(f"🔄 تعویض به API شماره {self.current_api_index + 1}")
        self.setup_llm()

    def create_knowledge_base(self, text: str):
        """ایجاد پایگاه دانش از متن کتاب"""
        if not self.llm:
            print("❌ مدل زبانی در دسترس نیست - استفاده از روش‌های معمولی")
            return False

        try:
            from llama_index.core import Document
            from llama_index.core import VectorStoreIndex
            from llama_index.core.node_parser import SentenceSplitter

            document = Document(text=text)
            parser = SentenceSplitter(chunk_size=512, chunk_overlap=64)
            nodes = parser.get_nodes_from_documents([document])

            self.knowledge_base = VectorStoreIndex(nodes, embed_model=self.embed_model)
            print("✅ پایگاه دانش RAG ایجاد شد")
            return True

        except Exception as e:
            print(f"❌ خطا در ایجاد پایگاه دانش: {e}")
            return False

