# 🎨 بخش ۷: رابط Gradio با طراحی مشکی و سبز
# ============================================================================

class GradioInterface:
    """رابط کاربری Gradio با طراحی مشکی و سبز"""
    
    def __init__(self):
        self.current_progress = 0
        self.current_message = "آماده برای پردازش..."
        self.processing = False
        
    def process_file(self, file):
        """پردازش فایل آپلود شده"""
        if file is None:
            return self._create_empty_result(), None, None, self._create_progress_html()
        
        try:
            self.processing = True
            self.current_progress = 0
            self.current_message = "🚀 شروع پردازش..."
            
            # ذخیره فایل آپلود شده
            file_path = file.name
            
            # ایجاد پردازشگر با callback
            processor = UltraAccuracyBookProcessor(self._update_progress_callback)
            
            # پردازش فایل
            results = processor.process_book_ultra_accurate(file_path)
            
            # ذخیره نتایج
            json_file, txt_file = self._save_results(results, file_path)
            
            # ایجاد نمایش زیبا
            display_html = self._create_display_html(results)
            
            self.processing = False
            return display_html, json_file, txt_file, self._create_progress_html()
            
        except Exception as e:
            self.processing = False
            error_html = self._create_error_html(str(e))
            return error_html, None, None, self._create_progress_html()
    
    def _update_progress_callback(self, value, message):
        """به‌روزرسانی پیشرفت"""
