class UltraAccuracyBookProcessor:
    """پردازشگر اصلی با قدرت API در هسته مرکزی"""

    def __init__(self):
        self.ai_models = HighAccuracyAIModels()
        self.ocr_engine = UltraAccuracyOCREngine(self.ai_models)
        self.rag_system = AdvancedRAGSystem()
        self.api_extractor = APIEnhancedMetadataExtractor(self.rag_system)
        self.simple_extractor = SimpleBookExtractor()

    def process_book_ultra_accurate(self, input_file) -> Dict[str, Any]:
        """پردازش کتاب با قدرت API"""
        print("🚀 شروع پردازش با دقت فوق‌العاده + API...")

        start_time = datetime.now()

        # استخراج متن
        raw_text, ocr_results = self.ocr_engine.extract_text_ultra_accurate(input_file)

        if not raw_text or len(raw_text.strip()) < 10:
            return self._create_error_result("متن کافی استخراج نشد", ocr_results, start_time)

        print(f"📖 متن استخراج شده: {len(raw_text)} کاراکتر")

        # ایجاد پایگاه دانش برای API
        rag_ready = self.rag_system.create_knowledge_base(raw_text)

        if rag_ready:
            # استخراج اصلی با قدرت API
            print("🧠 استخراج اطلاعات با قدرت API...")
            api_metadata = self.api_extractor.extract_with_api_power(raw_text)

            # استخراج پشتیبان با روش‌های معمولی
            backup_metadata = self._extract_backup_metadata(raw_text)

            # ترکیب نهایی با اولویت API
            final_metadata = self._final_fusion(api_metadata, backup_metadata, raw_text)
        else:
            # فقط روش‌های معمولی
            print("⚠️ استفاده از روش‌های معمولی (API در دسترس نیست)")
            final_metadata = self._extract_backup_metadata(raw_text)

        # ایجاد نتایج نهایی
        results = self._create_final_results(final_metadata, raw_text, ocr_results,
                                           rag_ready, start_time, input_file)

        return results

    def _extract_backup_metadata(self, text: str) -> Dict[str, Any]:
        """استخراج پشتیبان با روش‌های معمولی"""
        basic = self.simple_extractor.extract_basic_info(text)
        additional = self.simple_extractor.extract_additional_info(text)

        return {
            'basic_info': basic,
            'additional_info': additional
        }

    def _final_fusion(self, api_metadata: Dict, backup_metadata: Dict, text: str) -> Dict[str, Any]:
        """ترکیب نهایی با اولویت API و تمرکز بر بخش‌های حیاتی"""
        final = {
            'basic_info': backup_metadata.get('basic_info', {}).copy(),
            'additional_info': backup_metadata.get('additional_info', {}).copy(),
            'api_enhanced': True
        }

        # بخش‌های حیاتی که حتماً باید از API استفاده کنند
        critical_fields = ['title', 'author', 'translator', 'publisher', 'publication_year', 'isbn', 'edition']

        if api_metadata:
            for field in critical_fields:
                if api_metadata.get(field):
                    final['basic_info'][field] = api_metadata[field]
                    print(f"✅ API تعیین کرد ({field}): {api_metadata[field]}")
                elif field == 'translator' and self.api_extractor._is_translation_book(text):
                    print(f"⚠️ هشدار: کتاب ترجمه است اما مترجم پیدا نشد!")

            # سایر فیلدها
            additional_fields = ['subject', 'genre']
            for field in additional_fields:
                if api_metadata.get(field):
                    final['additional_info'][field] = api_metadata[field]

        return final

    def _create_final_results(self, metadata: Dict, text: str, ocr_results: Dict,
                            rag_ready: bool, start_time: datetime, input_file) -> Dict[str, Any]:
        """ایجاد ساختار نهایی نتایج"""

        return {
            'basic_info': metadata.get('basic_info', {}),
            'additional_info': metadata.get('additional_info', {}),
            'file_info': self._get_file_info(input_file),
            'processing_time': (datetime.now() - start_time).total_seconds(),
            'ocr_analysis': ocr_results,
            'rag_available': rag_ready,
            'api_enhanced': metadata.get('api_enhanced', False),
            'text_sample': text[:500] + "..." if len(text) > 500 else text,
            'processing_date': datetime.now().isoformat(),
            'total_text_length': len(text)
        }

    def _create_error_result(self, error: str, ocr_results: Dict, start_time: datetime):
        """ایجاد نتیجه خطا"""
        return {
            'error': error,
            'processing_time': (datetime.now() - start_time).total_seconds(),
            'ocr_analysis': ocr_results
        }

    def _get_file_info(self, input_file) -> Dict[str, Any]:
        """اطلاعات فایل"""
        if isinstance(input_file, str):
            return {
                'file_name': os.path.basename(input_file),
                'file_type': 'PDF' if input_file.lower().endswith('.pdf') else 'Image'
            }
        else:
            return {
                'file_name': 'uploaded_file',
                'file_type': 'Image'
            }

