class GradioBookExtractorUI:
    """رابط کاربری گریدو برای سیستم استخراج کتاب"""

    def __init__(self):
        self.processor = None
        self.current_results = None

    def initialize_processor(self):
        """مقداردهی اولیه پردازشگر"""
        if self.processor is None:
            try:
                print("🚀 در حال راه‌اندازی سیستم پردازش پیشرفته...")
                self.processor = UltraAccuracyBookProcessor()
                return "✅ سیستم پردازش با موفقیت راه‌اندازی شد!"
            except Exception as e:
                error_msg = f"❌ خطا در راه‌اندازی سیستم: {str(e)}"
                print(error_msg)
                return error_msg
        return "✅ سیستم از قبل راه‌اندازی شده است"

    def process_uploaded_file(self, file):
        """پردازش فایل آپلود شده"""
        if file is None:
            return "⚠️ لطفاً یک فایل آپلود کنید", "هیچ فایلی انتخاب نشده است"

        try:
            # مقداردهی اولیه پردازشگر
            init_msg = self.initialize_processor()
            if "❌" in init_msg:
                return init_msg, "خطا در راه‌اندازی سیستم"

            print(f"📁 پردازش فایل: {file.name}")
            # پردازش فایل
            results = self.processor.process_book_ultra_accurate(file.name)
            self.current_results = results

            # نمایش نتایج
            display_text = self._format_results_for_display(results)

            # ایجاد گزارش
            report_text = self._create_detailed_report(results)

            print("✅ پردازش کامل شد")
            return display_text, report_text

        except Exception as e:
            error_msg = f"❌ خطا در پردازش فایل: {str(e)}"
            print(error_msg)
            return error_msg, error_msg

    def _format_results_for_display(self, results):
        """فرمت‌بندی نتایج برای نمایش"""
        if 'error' in results:
            return f"## ❌ خطا\n\n{results['error']}"

        basic_info = results.get('basic_info', {})
        additional_info = results.get('additional_info', {})

        output = "## 🎯 نتایج استخراج اطلاعات کتاب\n\n"
        output += "### 📚 اطلاعات اصلی کتاب\n\n"

        # فیلدهای حیاتی
        fields = [
            ('title', '📖 عنوان کتاب'),
            ('author', '✍️ نویسنده/مؤلف'),
            ('translator', '🔤 مترجم'),
            ('publisher', '🏢 ناشر'),
            ('publication_year', '📅 سال انتشار'),
            ('isbn', '🔢 شابک (ISBN)'),
            ('edition', '🔄 نوبت چاپ')
        ]

        for field, display in fields:
            value = basic_info.get(field, "")
            if value:
                source = "🤖 API" if results.get('api_enhanced') else "🔍 الگو"
                output += f"- **{display}:** `{value}` ({source})\n"
            else:
                output += f"- **{display}:** ❌ پیدا نشد\n"

        # اطلاعات تکمیلی
        if additional_info:
            output += "\n### 📋 اطلاعات تکمیلی\n\n"
            for key, value in additional_info.items():
                if value:
                    output += f"- **{key}:** `{value}`\n"

        # اطلاعات فنی
        output += f"\n### 🔧 اطلاعات فنی\n\n"
        output += f"- **زمان پردازش:** {results.get('processing_time', 0):.2f} ثانیه\n"
        output += f"- **طول متن:** {results.get('total_text_length', 0)} کاراکتر\n"
        output += f"- **قدرت API:** {'فعال ✅' if results.get('api_enhanced') else 'غیرفعال ⚠️'}\n"
        output += f"- **سیستم RAG:** {'آماده ✅' if results.get('rag_available') else 'غیرفعال ⚠️'}\n"

        return output

    def _create_detailed_report(self, results):
        """ایجاد گزارش دقیق"""
        if 'error' in results:
            return f"خطا: {results['error']}"

        report = "📊 گزارش کامل تحلیل کتاب\n"
        report += "=" * 50 + "\n\n"

        # اطلاعات اصلی
        basic_info = results.get('basic_info', {})
        report += "📚 اطلاعات شناسنامه کتاب:\n"
        report += "-" * 30 + "\n"

        critical_fields = {
            'title': 'عنوان اصلی',
            'author': 'نویسنده/مؤلف',
            'translator': 'مترجم',
            'publisher': 'ناشر',
            'publication_year': 'سال انتشار',
            'isbn': 'شابک',
            'edition': 'نوبت چاپ'
        }

        for field, title in critical_fields.items():
            value = basic_info.get(field, "❌ پیدا نشد")
            report += f"- {title}: {value}\n"

        # اطلاعات فنی
        report += "\n🔧 اطلاعات فنی پردازش:\n"
        report += "-" * 30 + "\n"
        report += f"- زمان پردازش: {results.get('processing_time', 0):.2f} ثانیه\n"
        report += f"- طول متن استخراج شده: {results.get('total_text_length', 0)} کاراکتر\n"
        report += f"- سیستم API: {'فعال' if results.get('api_enhanced') else 'غیرفعال'}\n"
        report += f"- سیستم پرسش و پاسخ: {'فعال' if results.get('rag_available') else 'غیرفعال'}\n"

        # اطلاعات OCR
        ocr_info = results.get('ocr_analysis', {})
        if 'quality_metrics' in ocr_info:
            quality = ocr_info['quality_metrics']
            report += "\n📝 کیفیت استخراج متن:\n"
            report += "-" * 25 + "\n"
            report += f"- امتیاز کلی کیفیت: {quality.get('overall_score', 0):.2f}/1.0\n"
            report += f"- تعداد خطوط: {quality.get('line_count', 0)}\n"
            report += f"- نسبت متن فارسی: {quality.get('persian_ratio', 0)*100:.1f}%\n"

        report += f"\n🕒 تاریخ پردازش: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n"

        return report

    def save_results(self):
        """ذخیره نتایج"""
        if self.current_results is None:
            return None, "⚠️ هیچ نتیجه‌ای برای ذخیره کردن وجود ندارد"

        try:
            # ایجاد فایل موقت برای ذخیره
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

            # ذخیره JSON
            json_content = json.dumps(self.current_results, ensure_ascii=False, indent=2)
            json_filename = f"book_results_{timestamp}.json"

            # ذخیره گزارش متنی
            report_content = self._create_detailed_report(self.current_results)
            txt_filename = f"book_report_{timestamp}.txt"

            print(f"💾 نتایج ذخیره شد: {json_filename}, {txt_filename}")

            return [
                (json_filename, json_content),
                (txt_filename, report_content)
            ], "✅ نتایج با موفقیت ذخیره شدند"

        except Exception as e:
            error_msg = f"❌ خطا در ذخیره نتایج: {str(e)}"
            print(error_msg)
            return None, error_msg

