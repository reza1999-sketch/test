class AdvancedRAGSystem:
    """سیستم RAG پیشرفته برای استخراج و تحلیل متادیتا"""

    def __init__(self):
        self.setup_api_key()
        self.setup_llm()
        self.knowledge_base = None

    def setup_api_key(self):
        """دریافت API Key از کاربر"""
        if 'OPENROUTER_API_KEY' not in os.environ:
            print("🔑 لطفاً API Key OpenRouter خود را وارد کنید:")
            print("   (می‌توانید از https://openrouter.ai دریافت کنید)")
            api_key = getpass("API Key: ")
            os.environ['OPENROUTER_API_KEY'] = api_key
            self.api_key = api_key
            print("✅ API Key ذخیره شد")
        else:
            self.api_key = os.environ['OPENROUTER_API_KEY']

    def setup_llm(self):
        """تنظیم مدل زبانی"""
        try:
            from llama_index.llms.openrouter import OpenRouter
            from llama_index.embeddings.huggingface import HuggingFaceEmbedding
            from llama_index.core import VectorStoreIndex
            from llama_index.core.node_parser import SentenceSplitter

            self.llm = OpenRouter(
                model="meta-llama/llama-3-70b-instruct",
                temperature=0.1,
                max_tokens=2000,
                context_window=8000,
                api_key=self.api_key
            )

            self.embed_model = HuggingFaceEmbedding(
                model_name="sentence-transformers/paraphrase-multilingual-mpnet-base-v2"
            )

            print("✅ مدل زبانی RAG تنظیم شد")

        except Exception as e:
            print(f"❌ خطا در تنظیم مدل RAG: {e}")
            self.llm = None

    def create_knowledge_base(self, text: str):
        """ایجاد پایگاه دانش از متن کتاب"""
        if not self.llm:
            print("❌ مدل زبانی در دسترس نیست")
            return False

        try:
            from llama_index.core import Document
            from llama_index.core import VectorStoreIndex
            from llama_index.core.node_parser import SentenceSplitter

            document = Document(text=text)
            parser = SentenceSplitter(chunk_size=512, chunk_overlap=64)
            nodes = parser.get_nodes_from_documents([document])

            self.knowledge_base = VectorStoreIndex(nodes, embed_model=self.embed_model)
            print("✅ پایگاه دانش RAG ایجاد شد")
            return True

        except Exception as e:
            print(f"❌ خطا در ایجاد پایگاه دانش: {e}")
            return False

