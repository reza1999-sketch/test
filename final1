            ✅ **دستورالعمل اعتبارسنجی**:
            - اطلاعات نادرست را تصحیح کنید
            - اطلاعات ناقص را تکمیل کنید
            - کلمات به هم چسبیده را جدا کنید (مثلاً: "مصطفیرعیتی" → "مصطفی رعیتی")
            - مطمئن شوید سال انتشار حتماً استخراج شده باشد
            - فقط اطلاعات تأیید شده را برگردانید

            پاسخ را فقط به صورت JSON تصحیح شده برگردانید:
            """,

            'year_focused': """
            شما در حال استخراج اطلاعات سال انتشار کتاب هستید. لطفاً با دقت بالا سال انتشار را از متن زیر پیدا کنید:

            متن کتاب:
            {text}

            الگوهای سال انتشار:
            - سال شمسی: ۱۳۹۵, ۱۳۹۶, ۱۳۹۷, ۱۳۹۸, ۱۳۹۹, ۱۴۰۰, ۱۴۰۱, ۱۴۰۲, ۱۴۰۳
            - سال با فصل: "زمستان ۱۳۹۷", "بهار ۱۴۰۰", "پاییز ۱۳۹۸", "تابستان ۱۴۰۱"
            - سال میلادی: 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024
            - الگوهای متداول: "سال انتشار:", "چاپ سال", "تاریخ انتشار", "نشر در سال"

            فقط سال انتشار را به صورت عدد ۴ رقمی شمسی برگردانید. اگر پیدا نکردید "null" برگردانید.
            """
        }

    def extract_with_api_power(self, text: str) -> Dict[str, Any]:
        """استخراج متادیتا با قدرت API"""
        print("🧠 استخراج متادیتا با قدرت API...")

        if not self.rag_system.llm:
            print("❌ API در دسترس نیست - استفاده از روش‌های معمولی")
            return {}

        try:
            # مرحله 1: استخراج جامع با API
            chunk = text[:3000]
            prompt = self.extraction_prompts['comprehensive'].format(text=chunk)

            initial_metadata = self._call_api_for_extraction(prompt)

            if not initial_metadata:
                return {}

            # مرحله 2: اعتبارسنجی با API
            validation_prompt = self.extraction_prompts['validation'].format(
                text=chunk[:1500],
                metadata=json.dumps(initial_metadata, ensure_ascii=False)
            )

            validated_metadata = self._call_api_for_extraction(validation_prompt)

            # مرحله 3: ترکیب نتایج
            fused_metadata = self._fusion_metadata(initial_metadata, validated_metadata)

            # مرحله 4: پس‌پردازش و تصحیح
            final_metadata = self._post_process_metadata(fused_metadata, text)

            print("✅ استخراج با API تکمیل شد")
            return final_metadata

        except Exception as e:
            print(f"❌ خطا در استخراج با API: {e}")
            return {}

    def _call_api_for_extraction(self, prompt: str) -> Dict[str, Any]:
        """فراخوانی API برای استخراج"""
        try:
            from llama_index.core import Document
            doc = Document(text=prompt)

            query_engine = self.rag_system.knowledge_base.as_query_engine(
                llm=self.rag_system.llm,
                similarity_top_k=3,
                response_mode="compact"
            )

            response = query_engine.query(prompt)
            response_text = str(response).strip()

            return self._extract_json_from_response(response_text)

        except Exception as e:
            print(f"⚠️ خطا در فراخوانی API: {e}")
            return {}

    def _extract_json_from_response(self, response: str) -> Dict[str, Any]:
        """استخراج JSON از پاسخ API"""
        try:
            json_patterns = [
                r'\{[^{}]*\}',
                r'```json\s*(\{.*?\})\s*```',
                r'```\s*(\{.*?\})\s*```'
            ]

            for pattern in json_patterns:
                matches = re.findall(pattern, response, re.DOTALL)
                for match in matches:
                    try:
                        if isinstance(match, tuple):
                            match = match[0]
                        return json.loads(match)
                    except:
                        continue

            lines = response.split('\n')
            json_like = {}

            for line in lines:
                line = line.strip()
                if ':' in line and not line.startswith('{') and not line.startswith('}'):
                    parts = line.split(':', 1)
                    if len(parts) == 2:
                        key, value = parts
                        key = key.strip().strip('"\'')
                        value = value.strip().strip('",\'')
                        if key and value:
                            json_like[key] = value

            return json_like if json_like else {}

        except Exception as e:
            print(f"⚠️ خطا در استخراج JSON: {e}")
            return {}

    def _fusion_metadata(self, initial: Dict, validated: Dict) -> Dict[str, Any]:
        """ترکیب هوشمند متادیتا"""
        fused = initial.copy()

        for key, value in validated.items():
            if value and self._is_valid_value(key, value):
                fused[key] = value

        for key in list(fused.keys()):
            if not self._is_valid_value(key, fused[key]):
                del fused[key]

        return fused

    def _is_valid_value(self, key: str, value: Any) -> bool:
        """اعتبارسنجی مقادیر با تمرکز بر بخش‌های حیاتی"""
        if not value or value in ['پیدا نشد', 'مشخص نیست', 'null', 'None', '']:
            return False

        # قوانین اعتبارسنجی دقیق‌تر
        validation_rules = {
            'title': lambda v: 3 <= len(str(v)) <= 200 and len(re.findall(r'[آ-ی]', str(v))) >= 2,
            'author': lambda v: 2 <= len(str(v)) <= 100 and len(re.findall(r'[آ-ی]', str(v))) >= 1,
            'translator': lambda v: 2 <= len(str(v)) <= 80 and len(re.findall(r'[آ-ی]', str(v))) >= 1,
            'publisher': lambda v: 2 <= len(str(v)) <= 100 and len(re.findall(r'[آ-ی]', str(v))) >= 1,
            'publication_year': lambda v: self._is_valid_year(v),
            'isbn': lambda v: 5 <= len(str(v)) <= 20 and any(char.isdigit() or char in ['-', ' '] for char in str(v)),
            'edition': lambda v: 1 <= len(str(v)) <= 20,
        }

        validator = validation_rules.get(key, lambda v: bool(v and str(v).strip()))
        return validator(value)

    def _is_valid_year(self, year: Any) -> bool:
        """اعتبارسنجی سال"""
        if not year:
            return False

        year_str = str(year)
        if len(year_str) != 4:
            return False

        # سال باید بین ۱۳۰۰ تا ۱۴۰۵ باشد
        if year_str.startswith(('۱۳', '۱۴')):
            try:
                year_num = int(year_str)
                return 1300 <= year_num <= 1405
            except:
                return False
        return False

    def _post_process_metadata(self, metadata: Dict[str, Any], text: str) -> Dict[str, Any]:
        """پس‌پردازش و تصحیح متادیتا"""
        processed = metadata.copy()

        # تصحیح کلمات به هم چسبیده با الگوهای فارسی
        correction_patterns = {
            'author': [
                (r'مصطفی', 'مصطفی '),
                (r'رعیتی', ' رعیتی'),
                (r'محمد', 'محمد '),
                (r'احمد', 'احمد '),
                (r'حسین', 'حسین '),
                (r'علی', 'علی '),
                (r'(\w{4,})(\w{4,})', r'\1 \2')  # جدا کردن کلمات طولانی به هم چسبیده
            ],
            'publisher': [
                (r'زمزم', 'زمزم '),
                (r'سحر', ' سحر'),
                (r'انتشارات', 'انتشارات '),
                (r'نشر', 'نشر '),
                (r'(\w{3,})(\w{3,})', r'\1 \2')  # جدا کردن کلمات به هم چسبیده
            ],
            'title': [
                (r'(\w{4,})(\w{4,})', r'\1 \2')  # جدا کردن کلمات طولانی در عنوان
            ]
        }

        for field, patterns in correction_patterns.items():
            if field in processed and processed[field]:
                original = str(processed[field])
                for pattern, replacement in patterns:
                    original = re.sub(pattern, replacement, original)
                # حذف فاصله‌های اضافی
                processed[field] = re.sub(r'\s+', ' ', original).strip()

        # استخراج اختصاصی سال انتشار اگر پیدا نشده
        if not processed.get('publication_year'):
            year = self._extract_year_specialized(text)
            if year:
                processed['publication_year'] = year
                print(f"✅ سال انتشار پس‌پردازش: {year}")
            else:
                # تلاش با API متمرکز بر سال
                year = self._extract_year_fallback(text)
                if year:
                    processed['publication_year'] = year
                    print(f"✅ سال انتشار با API متمرکز: {year}")

        return processed

    def _extract_year_specialized(self, text: str) -> str:
        """استخراج تخصصی سال انتشار از متن"""
        # الگوهای مختلف سال
        year_patterns = [
            r'سال\s*انتشار\s*[:\-]\s*([۱۳۴۰-۹]{4})',
            r'چاپ\s*[:\-]\s*.*?([۱۳۴۰-۹]{4})',
            r'تاریخ\s*انتشار\s*[:\-]\s*([۱۳۴۰-۹]{4})',
            r'زمستان\s*([۱۳۴۰-۹]{4})',
            r'بهار\s*([۱۳۴۰-۹]{4})',
            r'تابستان\s*([۱۳۴۰-۹]{4})',
            r'پاییز\s*([۱۳۴۰-۹]{4})',
            r'([۱۳۴۰-۹]{4})\s*خورشیدی',
            r'©\s*\d{4}.*?([۱۳۴۰-۹]{4})',
            r'نشر\s*.*?([۱۳۴۰-۹]{4})',
            r'انتشار\s*.*?([۱۳۴۰-۹]{4})'
        ]

        for pattern in year_patterns:
            match = re.search(pattern, text)
            if match:
                year = match.group(1)
                if self._is_valid_year(year):
                    return year

        # جستجوی ساده‌تر برای هر عدد ۴ رقمی فارسی
        simple_year_match = re.findall(r'[۱۳۴۰-۹]{4}', text)
        for year in simple_year_match:
            if self._is_valid_year(year):
                # بررسی کنار بودن با کلمات کلیدی
                context_pattern = rf'.{{0,20}}{year}.{{0,20}}'
                context_match = re.search(context_pattern, text)
                if context_match:
                    context = context_match.group()
                    year_indicators = ['چاپ', 'انتشار', 'نشر', 'سال', 'تاریخ']
                    if any(indicator in context for indicator in year_indicators):
                        return year

        return ""

    def _extract_year_fallback(self, text: str) -> str:
        """روش جایگزین برای استخراج سال انتشار"""
        print("🔍 جستجوی اختصاصی برای سال انتشار...")

        # استفاده از API برای استخراج اختصاصی سال
        if self.rag_system.llm:
            try:
                year_prompt = self.extraction_prompts['year_focused'].format(text=text[:2000])
                from llama_index.core import Document
                doc = Document(text=year_prompt)

                query_engine = self.rag_system.knowledge_base.as_query_engine(
                    llm=self.rag_system.llm
                )

                response = query_engine.query(year_prompt)
                response_text = str(response).strip()

                # استخراج سال از پاسخ
                year_match = re.search(r'[۱۳۴۰-۹]{4}', response_text)
                if year_match and self._is_valid_year(year_match.group()):
                    return year_match.group()

            except Exception as e:
                print(f"⚠️ خطا در استخراج سال با API: {e}")

        return ""

    def _is_translation_book(self, text: str) -> bool:
        """تشخیص اینکه آیا کتاب ترجمه است"""
        translation_indicators = [
            'ترجمه', 'مترجم', 'translate', 'translation', 'ترجمه شده',
            'منبع اصلی', 'کتاب اصلی', 'نویسنده اصلی', 'برگردان'
        ]

        text_lower = text.lower()
        return any(indicator in text_lower for indicator in translation_indicators)

